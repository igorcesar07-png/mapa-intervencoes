rules_version = '2';
// Regras do Firestore do Mapa de Intervenções.
// Administrador: igordalmolin.eng@gmail.com (UID abaixo). Publicadas no console em 07/11/2026.
service cloud.firestore {
  match /databases/{db}/documents {
    function admin() { return request.auth != null && request.auth.uid == "Yhx9nZGch7btJ6kZaxoZz3cNLz62"; }
    // ajustes das fotos e camadas padrão: todos leem, só o administrador grava
    match /ajustes/{id} { allow read: if true; allow write: if admin(); }
    match /config/{id}  { allow read: if true; allow write: if admin(); }
    // senha que abre os dados cifrados do site: só o administrador
    match /privado/{id} { allow read, write: if admin(); }
    // qualquer outra coisa: ninguém
    match /{caminho=**} { allow read, write: if false; }
  }
}
